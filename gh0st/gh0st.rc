IDR_MAINFRAME MENU
BEGIN
    POPUP "程序(&H)"
    BEGIN
        MENUITEM "退出程序(&K)",                    IDM_EXIT
    END
    POPUP "设置(&M)"
    BEGIN
        MENUITEM "系统设置(&K)",                    IDM_SETTING
        MENUITEM "创建客户(&E)",                    IDM_BUILD
    END
    POPUP "界面(&C)"
    BEGIN
        MENUITEM "状态栏(&O)",                     ID_VIEW_STATUS_BAR
    END
    POPUP "帮助(&M)"
    BEGIN
        MENUITEM "关于(&A)..",                    ID_APP_ABOUT
    END
END

IDR_LIST MENU
BEGIN
    POPUP "MENU"
    BEGIN
        MENUITEM "文件管理(&H)",                    IDM_FILEMANAGER
        MENUITEM "屏幕控制(&K)",                    IDM_SCREENSPY
        MENUITEM "键盘记录(&M)",                    IDM_KEYBOARD
        MENUITEM "远程终端(&K)",                    IDM_REMOTESHELL
        MENUITEM "系统管理(&E)",                    IDM_SYSTEM
        MENUITEM "注 册 表(&C)",                   IDM_REGEDIT
        MENUITEM "服务管理(&O)",                    IDM_SERVICES
        MENUITEM "视频查看(&M)",                    IDM_WEBCAM
        MENUITEM "语音监听(&A)",                    IDM_AUDIO_LISTEN
        MENUITEM "内网代理(&B)",                    IDM_PROXY
        MENUITEM "主机管理(&C)",                    IDM_SYSINFO
        MENUITEM SEPARATOR
        MENUITEM "更改分组(&D)",                    IDM_CHANGEGROUP
        MENUITEM "更改备注(&E)",                    IDM_RENAME_REMARK
        POPUP "会话管理(&F)"
        BEGIN
            MENUITEM "卸载(&F)",                      IDM_REMOVE
            MENUITEM SEPARATOR
            MENUITEM "关机(&J)",                      IDM_SHUTDOWN
            MENUITEM "重启(&K)",                      IDM_REBOOT
            MENUITEM "注销(&U)",                      IDM_LOGOFF
        END
        POPUP "其它功能(&G)"
        BEGIN
            MENUITEM "下载执行(&T)",                    IDM_DOWNEXEC
            MENUITEM "下载更新(&J)",                    IDM_UPDATE_SERVER
            MENUITEM "发送消息(&E)",                    IDM_SEND_MSG
            MENUITEM "关防火墙(&B)",                    stopSD
            MENUITEM "清除日志(&L)",                    IDM_CLEANEVENT
            POPUP "访问网址(&V)"
            BEGIN
                MENUITEM "隐藏(&J)",                      IDM_OPEN_URL_HIDE
                MENUITEM "显示(&B)",                      IDM_OPEN_URL_SHOW
            END
        END
        POPUP "本地上传(&H)"
        BEGIN
            MENUITEM "隐藏运行(&Y)",                    IDM_START_HIDE
            MENUITEM "正常运行(&Z)",                    IDM_START_NORMAL
            MENUITEM "不去运行(&B)",                    IDM_NO_START
        END
        MENUITEM SEPARATOR
        MENUITEM "选择全部(&I)",                    IDM_SELECT_ALL
        MENUITEM "取消选择(&J)",                    IDM_UNSELECT_ALL
    END
END

IDR_FILEMANAGER MENU
BEGIN
    POPUP "FileManger"
    BEGIN
        MENUITEM "传输(&Q)",                      IDM_TRANSFER
        MENUITEM "重命名(&C)",                     IDM_RENAME
        MENUITEM "删除(&C)",                      IDM_DELETE
        MENUITEM "新建文件夹(&N)",                   IDM_NEWFOLDER
        MENUITEM SEPARATOR
        MENUITEM "本地打开(&O)",                    IDM_LOCAL_OPEN
        POPUP "远程打开(&O)"
        BEGIN
            MENUITEM "显示运行(&X)",                    IDM_REMOTE_OPEN_SHOW
            MENUITEM "隐藏运行(&Y)",                    IDM_REMOTE_OPEN_HIDE
        END
        MENUITEM SEPARATOR
        MENUITEM "刷新(&R)",                      IDM_REFRESH
    END
END

